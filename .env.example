# Copy to .env and fill in from your Supabase project:
# Dashboard → Project Settings → API
#
# Use your Project URL and the **publishable** key (sb_publishable_...)
# OR the legacy **anon public** key (eyJ...). Do NOT put the secret key in VITE_* vars.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Production site URL for sitemap.xml and canonical links (no trailing slash)
# VITE_SITE_URL=https://savannaexplorer.com

# Production deploy (manual rsync only — see README)
# DEPLOY_HOST=31.97.56.157
# DEPLOY_USER=root
# DEPLOY_PATH=/home/u123456789/domains/savannaexplorer.com/public_html

# Only for local seeding (npm run seed:supabase) — never commit this value
# SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
