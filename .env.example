# Copy to .env and fill in from your Supabase project:
# Dashboard → Project Settings → API
#
# Use your Project URL and the **publishable** key (sb_publishable_...)
# OR the legacy **anon public** key (eyJ...). Do NOT put the secret key in VITE_* vars.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Production site URL for sitemap.xml and canonical links (no trailing slash)
VITE_SITE_URL=https://savannaexplorer.com

# Optional SEO — injected at build time into index.html (see vite.config.js)
# GSC: Search Console → HTML tag method → paste content value only (not the full meta tag)
# VITE_GSC_VERIFICATION=abc123xyz
# GA4: Analytics → Admin → Data streams → Measurement ID
# VITE_GA4_ID=G-XXXXXXXXXX

# Manual Hostinger deploy (legacy — use Vercel; see docs/vercel-deploy.md)
# DEPLOY_HOST=31.97.56.157
# DEPLOY_USER=root
# DEPLOY_PATH=/var/www/savannaexplorer

# Vercel (docs/vercel-deploy.md) — set in Vercel dashboard OR GitHub Actions:
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_GSC_VERIFICATION, VITE_GA4_ID

# Only for local seeding (npm run seed:supabase) — never commit this value
# SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
